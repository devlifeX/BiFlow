{
  "name": "iran-split-desktop-workspace",
  "version": "6.2.13",
  "private": true,
  "packageManager": "pnpm@9.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "predev": "node scripts/sync-version.mjs && pnpm bundle:check",
    "dev": "pnpm --filter @iran-split/desktop dev",
    "prebuild": "node scripts/sync-version.mjs && pnpm bundle:check",
    "build": "pnpm --filter @iran-split/desktop build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @iran-split/desktop lint",
    "typecheck": "pnpm --filter @iran-split/desktop typecheck",
    "test": "pnpm --filter @iran-split/desktop test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "rules:update": "./scripts/update-rules.sh",
    "rules:check": "node scripts/sync-rules.mjs --check",
    "assets:check": "node scripts/check-bundled-assets.mjs",
    "bundle:check": "pnpm rules:check && pnpm assets:check",
    "test:e2e": "playwright test",
    "precheck": "node scripts/sync-version.mjs",
    "check": "pnpm version:check && pnpm bundle:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts",
    "github:action-test": "node scripts/ci-local.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@tauri-apps/cli": "2.5.0",
    "prettier": "3.5.3"
  }
}
