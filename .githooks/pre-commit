#!/usr/bin/env bash
# Hard commit gate: run the same checks CI's verify jobs run, before every
# commit, so a red GitHub Actions run on a plain push cannot happen again.
# Activate once per clone with:  git config core.hooksPath .githooks
# Bypassing with --no-verify is for emergencies only.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "${staged}" ]; then
  exit 0
fi

has_rust=false
has_frontend=false
while IFS= read -r file; do
  case "${file}" in
    *.rs | */Cargo.toml | Cargo.toml | Cargo.lock) has_rust=true ;;
  esac
  case "${file}" in
    # pnpm check runs prettier --check over the whole repo, so any file
    # prettier formats (md/json/yml/css/html included) must trigger it.
    apps/* | scripts/* | e2e/* | package.json | pnpm-lock.yaml | version | *.mjs | *.ts | *.tsx | *.md | *.json | *.yml | *.yaml | *.css | *.html) has_frontend=true ;;
  esac
done <<<"${staged}"

run() {
  echo "pre-commit: $*"
  "$@"
}

if [ "${has_rust}" = true ]; then
  # Mirrors .github/workflows/ci.yml rust + security jobs.
  run cargo fmt --all --check
  run cargo clippy --workspace --all-targets -- -D warnings
  run cargo test --workspace
  if command -v cargo-deny >/dev/null 2>&1; then
    # cargo-deny fetches the advisory database, which a filtered or offline
    # network cannot reach. A failed fetch must not block a commit — CI is the
    # authority — but a real advisory or license violation still must.
    echo "pre-commit: cargo deny check"
    deny_output="$(cargo deny check 2>&1)" || {
      if printf '%s' "${deny_output}" | grep -qiE "unable to access|gnutls|failed to fetch|could not fetch|network|timed out|resolve host"; then
        echo "pre-commit: advisory database is unreachable; CI will run cargo deny" >&2
      else
        printf '%s\n' "${deny_output}" >&2
        exit 1
      fi
    }
  else
    echo "pre-commit: cargo-deny is not installed; CI will still run it" >&2
  fi
fi

if [ "${has_frontend}" = true ]; then
  # Mirrors the CI verify job (format, lint, typecheck, unit tests, version sync).
  run pnpm check
fi

echo "pre-commit: all CI-mirror checks passed"
