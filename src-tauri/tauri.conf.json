{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiFlow",
  "version": "6.1.1",
  "identifier": "app.biflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm bundle:check && pnpm --dir apps/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm bundle:check && pnpm --dir apps/desktop build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "BiFlow",
        "width": 1120,
        "height": 760,
        "minWidth": 390,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../resources/rules/": "rules/",
      "../resources/licenses/": "licenses/"
    },
    "category": "Utility",
    "shortDescription": "Safe Iran split routing through Hiddify",
    "longDescription": "Routes Iranian traffic directly and other traffic through an existing Hiddify connection using a privileged helper.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "recommends": ["policykit-1"],
        "files": {
          "/usr/lib/biflow/iran-split-helper": "../packaging/staged/iran-split-helper",
          "/usr/lib/biflow/install-helper.sh": "../packaging/linux/install-helper.sh",
          "/usr/lib/biflow/iran-split-helper.service": "../packaging/linux/iran-split-helper.service",
          "/usr/lib/biflow/mihomo": "../vendor/mihomo/linux-x86_64/mihomo",
          "/usr/share/polkit-1/actions/app.biflow.install-helper.policy": "../packaging/linux/app.biflow.install-helper.policy"
        },
        "desktopTemplate": "../packaging/linux/app.desktop",
        "postInstallScript": "../packaging/linux/postinst.sh",
        "preRemoveScript": "../packaging/linux/prerm.sh"
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerHooks": "../packaging/windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/devlifeX/BiFlow/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRENDJBQzBEOUMyMTM0NUMKUldSY05DR2NEYXhDVFZUMVd6L0JZc1NHb0srR3JrKzd2S2RRdTBhMDkwenQrV05ITW9tejdkQkIK"
    }
  }
}
